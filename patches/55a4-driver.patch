+ */
+static void build_fdt_payload(FpiDeviceGoodixTls55X4 *self, guint8 kind,
+                              guint8 out[GOODIX55X4_FDT_PAYLOAD_LEN]) {
+  out[0] = kind;
+  out[1] = 0x01;
+  for (int i = 0; i != GOODIX55X4_FDT_ZONES; ++i) {
+    out[2 + i * 2] = 0x80;
+    out[3 + i * 2] = self->fdt_thresholds[i];
+  }
+}
