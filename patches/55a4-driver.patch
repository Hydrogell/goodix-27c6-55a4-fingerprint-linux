+/**
+ * @brief Drive the sensor's status LED.
+ *
+ * The LED is not wired to the laptop EC as long assumed — it is switched by
+ * command 0xae, which the community protocol notes call "QUERY_MCU_STATE" and
+ * which therefore looked like a harmless read. It is not: the Windows driver
+ * sends it in strictly alternating pairs, and the two payloads simply swap
+ * their first two bytes:
+ *
+ *     00 01 32  -> LED on
+ *     01 00 32  -> LED off
+ *
+ * Confirmed on real hardware. Windows lights it while waiting for a finger,
+ * which is why the light only ever appeared during its lock screen.
+ */
+static void goodix55x4_led_done(FpDevice *dev, guint8 *data, guint16 len,
+                                gpointer ssm, GError *error) {
+  FpiDeviceGoodixTls55X4 *self = FPI_DEVICE_GOODIXTLS55X4(dev);
+
+  if (error) {
+    // The light is cosmetic; it must never be able to fail an authentication.
+    fp_warn("LED command failed, continuing without it: %s", error->message);
+    g_error_free(error);
+  } else {
+    // Commit the cached state only once the device has actually acknowledged.
+    self->led_is_on = self->led_want_on;
+  }
+
+  if (ssm)
+    fpi_ssm_next_state(ssm);
+}
+
+static void goodix55x4_set_led(FpDevice *dev, gboolean on, FpiSsm *ssm) {
+  FpiDeviceGoodixTls55X4 *self = FPI_DEVICE_GOODIXTLS55X4(dev);
+  guint8 payload[3] = {on ? 0x00 : 0x01, on ? 0x01 : 0x00, 0x32};
+
+  // Already in the requested state: skip the command entirely. Sending it again
+  // physically toggles the light, which is what made it blink on every retry
+  // and between enrollment stages. Keep driving the SSM forward though.
+  if (self->led_is_on == on) {
+    if (ssm)
+      fpi_ssm_next_state(ssm);
+    return;
+  }
+
+  // Do NOT commit led_is_on here: goodix_send_protocol() drops the command with
+  // only a warning when the transport is still busy, and never calls back. A
+  // state cached before the send would then claim the light is on while it is
+  // dark, turning every later switch into a no-op.
+  self->led_want_on = on;
+  goodix_send_protocol(dev, GOODIX_CMD_QUERY_MCU_STATE, payload,
+                       sizeof(payload), NULL, TRUE, GOODIX_TIMEOUT, FALSE,
+                       goodix55x4_led_done, ssm);
+}
