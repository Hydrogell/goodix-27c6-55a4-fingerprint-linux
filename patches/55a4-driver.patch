+  for (int i = 0; i != GOODIX55X4_FDT_ZONES; ++i) {
+    const guint8 *p = data + GOODIX55X4_FDT_REPLY_HDR + i * 2;
+    guint16 base = (guint16)p[0] | ((guint16)p[1] << 8);
+    guint thr = base >> 1;
+    // Masking would wrap silently: this unit reports bases of 352-410, so only
+    // ~20% of headroom separates it from base >= 512. Saturate and say so.
+    if (thr > 0xff) {
+      fp_warn("FDT zone %d base 0x%x exceeds the 8-bit threshold field", i, base);
+      thr = 0xff;
+    }
+    self->fdt_thresholds[i] = (guint8)thr;
+  }
+  self->fdt_thresholds_valid = TRUE;
+
+  g_print("FDT thresholds learned from sensor:");
+  for (int i = 0; i != GOODIX55X4_FDT_ZONES; ++i)
+    g_print(" %02x", self->fdt_thresholds[i]);
+  g_print("\n");
+}
