+ * @brief Learn this sensor's finger-detect thresholds from an FDT reply.
+ *
+ * The device answers FDT commands with its currently measured per-zone base
+ * level (4 header bytes, then one LE uint16 per zone). The vendor driver turns
+ * those into the thresholds it sends back as base>>1; replicating that is what
+ * makes device-side finger detection work on this unit.
+ */
+static void learn_fdt_thresholds(FpiDeviceGoodixTls55X4 *self,
+                                 const guint8 *data, guint16 len) {
+  // Only for device ids flagged for it — see GOODIX_55X4_FLAG_LEARN_FDT.
+  if (!(fpi_device_get_driver_data(FP_DEVICE(self)) &
+        GOODIX_55X4_FLAG_LEARN_FDT))
+    return;
+
+  if (data == NULL ||
+      len < GOODIX55X4_FDT_REPLY_HDR + GOODIX55X4_FDT_ZONES * 2) {
+    g_print("FDT: reply too short (%u B), keeping previous thresholds\n", len);
+    return;
+  }
